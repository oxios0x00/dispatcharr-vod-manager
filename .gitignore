# Per-install runtime state (probe cache, queue, run log) — never source.
# Lives one level up from this repo when deployed (sibling of the plugin's
# own folder under Dispatcharr's plugins directory), but a local checkout
# run with VOD_MANAGER_DATA_DIR unset can still create it here.
data/
vod_manager_data/

# Python
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Personal working notes and reference material — not part of the plugin repo
NOTES.md
SPEC.md
CATALOG_SNAPSHOT_*.md
reference/
.git-old-vod-manager-backup/

# Ad hoc Django-shell scripts for testing against a live Dispatcharr
# instance — personal, throwaway-by-design, never part of the plugin
scripts/
